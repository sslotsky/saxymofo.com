---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<lazy-youtube class="video" data-id={id} data-title={title}>
  <a
    href={`https://www.youtube.com/watch?v=${id}`}
    aria-label={`Play ${title}`}
  >
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      loading="lazy"
      decoding="async"
    />
    <span class="play" aria-hidden="true"></span>
  </a>
</lazy-youtube>

<script>
  class LazyYouTube extends HTMLElement {
    connectedCallback() {
      this.querySelector("a")?.addEventListener("click", (event) => {
        event.preventDefault();
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${this.dataset.id}?autoplay=1`;
        iframe.title = this.dataset.title ?? "YouTube video";
        iframe.allow =
          "autoplay; encrypted-media; picture-in-picture; fullscreen";
        iframe.allowFullscreen = true;
        this.replaceChildren(iframe);
      });
    }
  }
  customElements.define("lazy-youtube", LazyYouTube);
</script>

<style>
  .video {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .video a,
  .video img,
  .video :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video img {
    object-fit: cover;
  }

  .play {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 4.5rem;
    height: 4.5rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.4);
    transition: scale 0.15s;
  }

  .play::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 54%;
    translate: -50% -50%;
    border-style: solid;
    border-width: 0.8rem 0 0.8rem 1.3rem;
    border-color: transparent transparent transparent var(--bg);
  }

  .video a:hover .play {
    scale: 1.08;
  }
</style>
