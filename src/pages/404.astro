---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <section class="section wrap">
    <p class="eyebrow">404</p>
    <h1>
      Wrong <em class="flourish">changes</em>
    </h1>
    <p class="lede">That page isn't on the set list. Take it from the top?</p>
    <a class="button" href="/">
      Back home
    </a>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(3rem, 9vw, 5.5rem);
  }
</style>
