---
import Base from "../layouts/Base.astro";
import YouTube from "../components/YouTube.astro";
import { videos } from "../data/videos";
import { site } from "../data/site";
---

<Base title="Videos" description="Watch Sam Slotsky play saxophone.">
  <section class="section wrap">
    <p class="eyebrow">Videos</p>
    <h1>Watch</h1>
    {videos.length > 0 ? (
      <div class="grid">
        {videos.map((video) => (
          <figure>
            <YouTube id={video.youtubeId} title={video.title} />
            <figcaption>
              <strong>{video.title}</strong>
              {video.with && <span class="muted"> with {video.with}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <p class="card empty">
        Videos are on the way. For now, clips from recent gigs are on{" "}
        <a href={site.instagram}>Instagram</a>.
      </p>
    )}
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(3rem, 9vw, 5.5rem);
  }

  .grid {
    display: grid;
    gap: 2rem 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }

  figure {
    margin: 0;
  }

  figcaption {
    margin-top: 0.75rem;
  }

  .empty {
    color: var(--muted);
    margin: 0;
  }
</style>
